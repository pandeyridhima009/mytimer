<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Cozy Pomodoro</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fff5f2;
    font-family: Georgia, serif;
    color: #795b60;
}

.container {
    width: 90%;
    max-width: 450px;
    padding: 35px;
    text-align: center;
    background: #fffdfb;
    border: 2px solid #f3d8d6;
    border-radius: 25px;
    box-shadow: 0 10px 35px #e9c7c455;
}

h1 {
    color: #c47d91;
    font-size: 28px;
}

.subtitle {
    color: #b99a9d;
    font-size: 14px;
}

.timer {
    font-family: monospace;
    font-size: 75px;
    margin: 30px 0;
    color: #c47d91;
}

.modes button, .controls button {
    border: none;
    padding: 11px 15px;
    margin: 4px;
    border-radius: 12px;
    cursor: pointer;
    background: #f9e8e7;
    color: #956b75;
    font-size: 14px;
}

.controls button {
    background: #d99aaa;
    color: white;
    padding: 12px 25px;
}

button:hover {
    opacity: 0.8;
}

#sessions {
    margin-top: 25px;
    font-size: 14px;
    color: #b99a9d;
}
</style>

</head>

<body>

<div class="container">
    <h1>♡ My Cozy Study Timer ♡</h1>
    <p class="subtitle">a little progress every day</p>

```
<div class="modes">
    <button onclick="setTimer(25)">Study</button>
    <button onclick="setTimer(5)">Short Break</button>
    <button onclick="setTimer(15)">Long Break</button>
</div>

<div class="timer" id="timer">25:00</div>

<div class="controls">
    <button onclick="startTimer()">Start</button>
    <button onclick="pauseTimer()">Pause</button>
    <button onclick="resetTimer()">Reset</button>
</div>

<p id="sessions">Completed sessions: 0</p>
```

</div>

<script>
let duration = 25 * 60;
let remaining = duration;
let interval = null;
let sessions = 0;

function updateDisplay() {
    let minutes = Math.floor(remaining / 60);
    let seconds = remaining % 60;

    document.getElementById("timer").textContent =
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0");
}

function setTimer(minutes) {
    clearInterval(interval);
    interval = null;
    duration = minutes * 60;
    remaining = duration;
    updateDisplay();
}

function startTimer() {
    if (interval !== null || remaining <= 0) return;

    interval = setInterval(() => {
        remaining--;
        updateDisplay();

        if (remaining <= 0) {
            clearInterval(interval);
            interval = null;

            if (duration === 25 * 60) {
                sessions++;
                document.getElementById("sessions").textContent =
                    "Completed sessions: " + sessions;
            }

            alert("Time's up! Take a little break ♡");
        }
    }, 1000);
}

function pauseTimer() {
    clearInterval(interval);
    interval = null;
}

function resetTimer() {
    pauseTimer();
    remaining = duration;
    updateDisplay();
}

updateDisplay();
</script>

</body>
</html>

